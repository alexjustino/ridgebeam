      "name": {
        "en": "Protection and strip-out of the flat",
        "pt-BR": "Proteção e demolição do apartamento"
      },
      "checks": {
        "start": [
          {
            "en": "Has the building management approved the works and the working hours?",
            "pt-BR": "O condomínio autorizou a obra e os horários de trabalho?"
          },
          {
            "en": "Were the neighbours told when the noisy days will be?",
            "pt-BR": "Os vizinhos foram avisados sobre os dias de barulho?"
          },
          {
            "en": "Is there an agreed place and time for the debris container?",
            "pt-BR": "Há lugar e horário combinados para a caçamba de entulho?"
          }
        ],
        "close": [
          {
            "en": "Are the lift, the corridor and the entrance protected?",
            "pt-BR": "O elevador, o corredor e a entrada estão protegidos?"
          },
          {
            "en": "Are the old floors that are going removed, down to a sound base?",
            "pt-BR": "Os pisos antigos que saem foram removidos, até uma base firme?"
          },
          {
            "en": "Has all the debris left the building?",
            "pt-BR": "Todo o entulho já saiu do prédio?"
          }
        ]
      },
