      "decisions": [
        {
          "key": "repair-or-replace",
          "name": {
            "en": "Repair the timber or replace it",
            "pt-BR": "Reparar o madeiramento ou trocá-lo"
          },
          "leadDays": {
            "min": 3,
            "max": 10
          },
          "needs": "repair-timber"
        }
      ],
      "activities": [
        {
          "key": "repair-timber",
          "name": {
            "en": "Replace or reinforce the damaged pieces",
            "pt-BR": "Substituir ou reforçar as peças danificadas"
          },
          "durationDays": {
            "min": 2,
            "max": 5
          },
          "rooms": ["roof"]
        },
        {
          "key": "treat-timber",
          "name": {
            "en": "Treat the timber against insects and damp",
            "pt-BR": "Tratar a madeira contra cupim e umidade"
          },
          "durationDays": {
            "min": 1,
            "max": 2
          },
          "rooms": ["roof"]
        }
      ]
    },
    {
      "key": "roof-covering",
      "name": {
        "en": "Underlay and covering",
        "pt-BR": "Subcobertura e telhamento"
      },
      "checks": {
        "start": [
          {
            "en": "Is the repaired structure approved?",
            "pt-BR": "A estrutura reparada foi aprovada?"
          },
          {
            "en": "Are the tiles on site, counted, with some to spare?",
            "pt-BR": "As telhas estão na obra, contadas, com sobra?"
          }
        ],
        "close": [
          {
            "en": "Are the tiles in line and fixed where the wind needs it, with none cracked?",
            "pt-BR": "As telhas estão alinhadas e fixadas onde o vento exige, sem nenhuma trincada?"
          },
          {
            "en": "Is the ridge bedded and fixed along its whole length?",
            "pt-BR": "A cumeeira está assentada e fixada em todo o comprimento?"
          }
        ]
      },
