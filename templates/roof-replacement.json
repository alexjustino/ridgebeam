        ],
        "close": [
          {
            "en": "Did a hose test over the valleys and the flashings leave no water inside?",
            "pt-BR": "O teste com mangueira nas águas-furtadas e nos rufos terminou sem nenhuma infiltração?"
          },
          {
            "en": "Do the gutters drain, with no water standing in them?",
            "pt-BR": "As calhas escoam, sem água parada?"
          }
        ]
