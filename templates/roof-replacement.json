{
  "ridgebeamTemplate": 1,
  "id": "roof-replacement",
  "version": 1,
  "title": {
    "en": "Roof replacement",
    "pt-BR": "Troca de telhado"
  },
  "summary": {
    "en": "The pitched roof of a small house stripped and laid again: access, the old covering off, the timber repaired, a new underlay and covering, flashings and gutters. A starting point, not a quote: ranges of working days to confirm with the roofer, and cost lines with no prices.",
    "pt-BR": "O telhado de uma casa pequena retirado e refeito: acesso, retirada das telhas antigas, reparo do madeiramento, nova subcobertura e telhamento, rufos e calhas. Um ponto de partida, não um orçamento: faixas de dias úteis para confirmar com o telhadista, e linhas de custo sem preço."
  },
  "rooms": [
    {
      "key": "roof",
      "name": {
        "en": "Roof",
        "pt-BR": "Telhado"
      }
    }
  ],
  "stages": [
    {
      "key": "roof-access",
      "name": {
        "en": "Access and protection",
        "pt-BR": "Acesso e proteção"
      },
      "checks": {
        "start": [
          {
            "en": "Is the ground where the scaffold stands firm and level?",
            "pt-BR": "O chão onde o andaime vai ficar está firme e nivelado?"
          },
          {
            "en": "Are the rooms below cleared or covered?",
            "pt-BR": "Os cômodos abaixo estão desocupados ou cobertos?"
          }
        ],
        "close": [
          {
            "en": "Is the scaffold braced, with guard rails, and checked before anybody climbs?",
            "pt-BR": "O andaime está travado, com guarda-corpo, e conferido antes de alguém subir?"
          },
          {
            "en": "Are there anchor points and harnesses for everybody working at height?",
            "pt-BR": "Há pontos de ancoragem e cintos para todos que trabalham em altura?"
          },
          {
            "en": "Is there a tarpaulin on site big enough to cover the open roof overnight?",
            "pt-BR": "Há uma lona na obra grande o bastante para cobrir o telhado aberto à noite?"
          }
        ]
      },
      "costLines": [
        {
          "label": {
            "en": "Scaffold hire",
            "pt-BR": "Locação de andaime"
          },
          "activity": "scaffold"
        },
        {
          "label": {
            "en": "Protection materials",
            "pt-BR": "Material de proteção"
          }
        }
      ],
      "decisions": [],
      "activities": [
        {
          "key": "scaffold",
          "name": {
            "en": "Put up the scaffold and the edge protection",
            "pt-BR": "Montar o andaime e a proteção de borda"
          },
          "durationDays": {
            "min": 1,
            "max": 3
          },
          "rooms": ["roof"]
        },
        {
          "key": "protect-below",
          "name": {
            "en": "Protect the rooms and the ground below",
            "pt-BR": "Proteger os cômodos e o quintal abaixo"
          },
          "durationDays": {
            "min": 1,
            "max": 2
          }
        }
      ]
    },
    {
      "key": "roof-strip",
      "name": {
        "en": "Strip the old roof",
        "pt-BR": "Retirada do telhado antigo"
      },
      "checks": {
        "start": [
          {
            "en": "Is the forecast dry for the days the roof will be open?",
            "pt-BR": "A previsão é de tempo seco para os dias em que o telhado ficará aberto?"
          },
          {
            "en": "Is there a safe way to lower the debris — a chute, a hoist or a fenced drop zone?",
            "pt-BR": "Há um jeito seguro de descer o entulho — tubo, guincho ou área isolada?"
          }
        ],
        "close": [
          {
            "en": "Was the old timber inspected, and every rotten or broken piece marked?",
            "pt-BR": "O madeiramento antigo foi inspecionado, e cada peça podre ou quebrada marcada?"
          },
          {
            "en": "Is the open roof covered at the end of each day?",
            "pt-BR": "O telhado aberto é coberto ao fim de cada dia?"
          }
        ]
      },
      "costLines": [
        {
          "label": {
            "en": "Strip-out labour",
            "pt-BR": "Mão de obra de retirada"
          }
        },
        {
          "label": {
            "en": "Debris removal",
            "pt-BR": "Retirada de entulho"
          }
        }
      ],
      "decisions": [],
      "activities": [
        {
          "key": "remove-covering",
          "name": {
            "en": "Take off the old tiles or sheets",
            "pt-BR": "Retirar as telhas antigas"
          },
          "durationDays": {
            "min": 2,
            "max": 4
          },
          "rooms": ["roof"]
        },
        {
          "key": "remove-battens",
          "name": {
            "en": "Take off the old battens and underlay",
            "pt-BR": "Retirar as ripas e a manta antigas"
          },
          "durationDays": {
            "min": 1,
            "max": 2
          },
          "rooms": ["roof"]
        },
        {
          "key": "inspect-timber",
          "name": {
            "en": "Inspect the timber",
            "pt-BR": "Inspecionar o madeiramento"
          },
          "durationDays": {
            "min": 1,
            "max": 2
          },
          "rooms": ["roof"]
        }
      ]
    },
    {
      "key": "roof-structure",
      "name": {
        "en": "Roof timber",
        "pt-BR": "Madeiramento"
      },
      "checks": {
        "start": [
          {
            "en": "Is the replacement timber on site, treated and dry?",
            "pt-BR": "A madeira de reposição está na obra, tratada e seca?"
          }
        ],
        "close": [
          {
            "en": "Are the rafters straight and in one plane, checked with a line?",
            "pt-BR": "Os caibros estão retos e no mesmo plano, conferidos com linha?"
          },
          {
            "en": "Did the engineer or the carpenter in charge see the repaired structure?",
            "pt-BR": "O engenheiro ou o carpinteiro responsável viu a estrutura reparada?"
          }
        ]
      },
      "costLines": [
        {
